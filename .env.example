# Copy this file to .env or export these variables in your shell.
# Do not commit real keys or private service URLs.

# OpenAI-compatible API for GPT models or relay services.
OPENAI_API_KEY=your_api_key
OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1

# Optional legacy alias used by some libraries/scripts.
OPENAI_API_BASE=https://your-openai-compatible-endpoint/v1

# LlamaParse / LlamaCloud, only needed if parsing SKF.pdf again.
LLAMA_CLOUD_API_KEY=your_llamacloud_key

# HTTP embedding service. Current experiments use bge-m3 through this service.
EMBEDDING_URL=http://your-embedding-service

# HTTP reranker service. Current experiments use bge-reranker-v2-m3.
RERANKER_URL=http://your-reranker-service

# OpenAI-compatible Ollama endpoint for llama3.3:70b.
OLLAMA_BASE_URL=http://your-ollama-service
OLLAMA_API_KEY=your_ollama_gateway_key

# Default model names used by commands in README.md.
EMBEDDING_MODEL=bge-m3
RERANKER_MODEL=bge-reranker-v2-m3
LLM_MODEL=llama3.3:70b
JUDGE_MODEL=gpt-4o-mini
